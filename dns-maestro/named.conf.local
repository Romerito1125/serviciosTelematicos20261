zone "empresa.local" {
	type master;
	file "/etc/bind/db.empresa.local";
	allow-transfer { 192.168.50.4; };
	notify yes;
};

zone "juanZuluaga.com" {
	type master;
	file "/etc/bind/db.juanZuluaga.com";
	allow-transfer { 192.168.50.4; };
	notify yes;	
};

/* Zona inversa */ 

zone "50.168.192.in-addr.arpa" {
	type master;
	file "/etc/bind/db.192";
	allow-transfer { 192.168.50.4; };
	notify yes; 
};

